# Secrets referenced as ${VAR} in eudiplo-config/playground/**.json.
# Copy to .env, fill in the values and provide them as environment variables to the EUDIPLO backend.
# All names start with PLAYGROUND_, so other tenants on the same EUDIPLO instance can't clash with them.

# clients/playground.json
PLAYGROUND_CLIENT_SECRET=

# clients/playground-admin.json
PLAYGROUND_ADMIN_CLIENT_SECRET=

# issuance/issuance.json
PLAYGROUND_CHAINED_AUTH_CLIENT_SECRET=

# key-chains/access-cert.json
PLAYGROUND_KEY_ACCESS_CERT_D=

# key-chains/attestation.json
PLAYGROUND_KEY_ATTESTATION_D=

# key-chains/status-list.json
PLAYGROUND_KEY_STATUS_LIST_D=

# key-chains/trust-list.json
PLAYGROUND_KEY_TRUST_LIST_D=

# Non-secret variables with defaults (optional)
PLAYGROUND_URL=https://playground.eudi-wallet.org
PLAYGROUND_ATTRIBUTE_PROVIDER_URL=http://localhost:8787/claims
PLAYGROUND_WEBHOOK_NOTIFICATION_URL=http://localhost:8787
